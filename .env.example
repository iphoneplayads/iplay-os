# Supabase — NUNCA commitar valores reais aqui.
# Copie para .env e preencha localmente.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend: 'true' (padrão) = mocks locais, admin aberto (dev).
# 'false' + credenciais acima = Supabase real, /admin exige login.
VITE_USE_MOCK=true

# Tenant público (slug resolvido no banco via RPC; sem UUID no código)
# VITE_COMPANY_SLUG=iplay
